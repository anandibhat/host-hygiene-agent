# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.obj
*.pyd

# Virtual environments
.env
.env.*
*.env
.venv/
venv/
ENV/
env/
build/
dist/
*.egg-info/

# IDE and Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db
Desktop.ini

# Daily reports and personal host scan logs (contains host-specific telemetry)
daily_reports/*
!daily_reports/.gitkeep

# Logs and outputs
*.log
